ID=citrus-ranking-bot
MAIN=artifacts/discord-bot/dist/index.mjs
NAME=Citrus Ranking Bot
DESCRIPTION=Roblox group ranking Discord bot
VERSION=1.0
RAM=100
TYPE=bot
